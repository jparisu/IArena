package "utilizing.structuring" {

    abstract class GenericRegistry {
    + __init__(name_convention: Callable[[str], str] | None): None
    + register(obj: T, name: str, aliases: Sequence[str] | None, overwrite: bool): str
    + register_alias(alias: str, target_existing_alias: str, overwrite: bool): None
    + get(name: str, strict: bool): T | None
    + remove_alias(name: str): None
    + remove_value(name: str): T | None
    + has(name: str): bool
    + list_aliases(): List[str]
    + __contains__(name: str): bool
    + __len__(): int
    + clear(): None
    }

    abstract class GenericFactory {
    + register_constructor(constructor: Callable[..., T], name: str, aliases: List[str] | None, overwrite: bool): None
    + construct(name: str, **kwargs: Any): T
    }

    class GenericSingleton {
    + __init__(cls: type[T]): None
    + __call__(*args: object, **kwargs: object): T
    + get_instance(): T
    }

    enum GenericEnumRegistry {
    + {static} get_all_values(): List[Any]
    + get(index: int | None): Any
    + {static} find(query: str, throw: bool, only_keys: bool): T | None
    + {static} from_string(value: str, throw: bool): T | None
    + {static} name_convention(name: str): str
    + {static} default(): T | None
    + {static} aliases(): dict[str, str]
    }

    class GenericParameter {
    + {static} from_dict(data: dict[str, Any]): T
    + update_from_dict(data: Mapping[str, Any]): T
    - _convert_value(target_type: Any, value: Any): Any
    + to_dict(target_format: str | None): dict[str, Any]
    + set_default_value(field_name: str, default_value: Any): None
    + {static} aliases(): dict[str, str]
    + copy(): T
    }

    class GenericSuiteParameter {
    + parameter_cls: type[ParameterType]
    + fixed_values: dict[str, Any]
    + suite_values: dict[str, List[Any]]
    + __init__(parameter_cls: type[ParameterType], fixed_values: Mapping[str, Any], suite_values: Mapping[str, Sequence[Any]]): None
    + {static} from_dict(parameter_cls: type[ParameterType], src: Mapping[str, Any], suite_prefix: str, treat_plain_lists_as_suite: bool): GenericSuiteParameter[ParameterType] | ParameterType
    + to_dict(target_format: str | None): dict[str, Any]
    + length(): int
    + individual_parameters(): Iterator[ParameterType]
    + individual_parameter(): Iterator[ParameterType]
    }

}

